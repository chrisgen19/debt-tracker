generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
}

enum DebtStatus {
  DEBT
  PAID
}

enum PaymentEventType {
  PAID
  UNPAID
}

enum ReceiptStatus {
  /// Presigned and handed to the browser, but the object is not confirmed in R2 yet.
  PENDING
  /// HeadObject succeeded, so the image is really there and safe to link to an entry.
  STORED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  householdId      String?
  household        Household?     @relation(fields: [householdId], references: [id], onDelete: SetNull)
  lentDebts        Debt[]         @relation("DebtLender")
  borrowedDebts    Debt[]         @relation("DebtBorrower")
  createdDebts     Debt[]         @relation("DebtCreator")
  paymentEvents    PaymentEvent[] @relation("PaymentActor")
  uploadedReceipts Receipt[]      @relation("ReceiptUploader")

  @@index([householdId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Household {
  id             String         @id @default(cuid())
  name           String         @default("Our household")
  inviteCode     String         @unique
  currency       String         @default("PHP")
  categoryConfig Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  members        User[]
  debts          Debt[]
  paymentEvents  PaymentEvent[]
  receipts       Receipt[]
}

model Debt {
  id            String        @id @default(cuid())
  itemName      String
  category      String
  amount        Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  notes         String?
  incurredAt    DateTime
  status        DebtStatus    @default(DEBT)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  lenderId    String
  lender      User      @relation("DebtLender", fields: [lenderId], references: [id], onDelete: Restrict)
  borrowerId  String
  borrower    User      @relation("DebtBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  createdById String
  createdBy   User      @relation("DebtCreator", fields: [createdById], references: [id], onDelete: Restrict)

  /// Evidence the money changed hands when the entry was logged. Optional: plenty of
  /// household debts start as a verbal "I'll pay you back".
  borrowReceiptId String?
  borrowReceipt   Receipt? @relation("DebtBorrowReceipt", fields: [borrowReceiptId], references: [id], onDelete: SetNull)
  /// Evidence of settlement. Cleared alongside `paidAt` when an entry is un-paid.
  /// One receipt can be shared by every entry a single transfer settled.
  paidReceiptId   String?
  paidReceipt     Receipt? @relation("DebtPaidReceipt", fields: [paidReceiptId], references: [id], onDelete: SetNull)

  paymentEvents PaymentEvent[]

  @@index([householdId, incurredAt])
  @@index([borrowerId, status])
  @@index([lenderId, status])
  @@index([householdId, status, paidAt])
}

/// Append-only log of every settle / un-settle. `Debt.paidAt` stays the fast
/// current-state field; this table is what survives an entry being un-paid.
model PaymentEvent {
  id         String           @id @default(cuid())
  type       PaymentEventType
  amount     Decimal          @db.Decimal(12, 2)
  occurredAt DateTime         @default(now())
  createdAt  DateTime         @default(now())

  debtId      String
  debt        Debt      @relation(fields: [debtId], references: [id], onDelete: Cascade)
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Who recorded the transition. Null for rows seeded by the backfill, where
  /// the person who marked the entry paid was never captured.
  actorId     String?
  actor       User?     @relation("PaymentActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([householdId, occurredAt])
  @@index([debtId, occurredAt])
}

/// One uploaded image in R2, owned by a household rather than by a single entry.
/// That indirection is the point: settling three debts with one GCash transfer
/// links all three to this same row, so the screenshot is stored and fetched once.
model Receipt {
  id          String        @id @default(cuid())
  /// R2 object key. Unique so a retry can never quietly point two rows at one object.
  key         String        @unique
  contentType String
  /// Filled in from HeadObject at confirm time, so it reflects what R2 actually holds
  /// rather than what the browser claimed before uploading.
  byteSize    Int?
  status      ReceiptStatus @default(PENDING)
  createdAt   DateTime      @default(now())

  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User      @relation("ReceiptUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  borrowFor Debt[] @relation("DebtBorrowReceipt")
  paidFor   Debt[] @relation("DebtPaidReceipt")

  /// Drives the orphan sweep: pending rows older than a day own an object nothing
  /// will ever link to.
  @@index([householdId, status, createdAt])
}
